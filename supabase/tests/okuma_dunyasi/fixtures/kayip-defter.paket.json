  "sayfalar": [
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " kütüphanenin en arka rafında, tozlu bir defter"
        },
        {
          "t": "ikon",
          "v": "📓"
        },
        {
          "t": "metin",
          "v": " buldu. Kapağında soluk mavi bir harita"
        },
        {
          "t": "ikon",
          "v": "🗺️"
        },
        {
          "t": "metin",
          "v": " çizilmişti. Kenarına küçük harflerle bir not yazılmıştı: \"Gizli köşeyi ancak birlikte bulursunuz.\" Defteri açınca sayfalardan eski bir kâğıt kokusu yayıldı. Bu not, "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " için "
        },
        {
          "t": "kelime",
          "yuva": "gizemli_sifat"
        },
        {
          "t": "metin",
          "v": " bir davetti."
        },
        {
          "t": "isaret",
          "kod": "kitap"
        },
        {
          "t": "metin",
          "v": " Defterin kimin olduğunu ve neden raflara kaldırıldığını bilmiyordu. Ama içinde bir sırrın saklı olduğunu hissediyordu."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Defteri masaya taşıdığında kütüphaneci Gülşen Hanım yanına geldi. Yıllardır bu kütüphanede çalışıyordu, ama bu defteri hiç görmemişti. Haritada üç işaret vardı: bir yıldız"
        },
        {
          "t": "ikon",
          "v": "⭐"
        },
        {
          "t": "metin",
          "v": ", bir kitap"
        },
        {
          "t": "ikon",
          "v": "📖"
        },
        {
          "t": "metin",
          "v": " ve bir kapı. Gülşen Hanım gülümsedi: \"Bu defter"
        },
        {
          "t": "ikon",
          "v": "📓"
        },
        {
          "t": "metin",
          "v": " yıllar önce okulun unutulmuş bilim köşesine ait olabilir. Ama o köşeye giden yolu bugüne kadar kimse bulamadı.\" Bu sözler merakı daha da artırdı."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " haritayı önce tek başına çözmeye karar verdi. Yıldız"
        },
        {
          "t": "ikon",
          "v": "⭐"
        },
        {
          "t": "metin",
          "v": " işareti, kütüphanenin camından vuran güneş"
        },
        {
          "t": "ikon",
          "v": "☀️"
        },
        {
          "t": "metin",
          "v": " ışığının düştüğü bir köşeyi gösteriyordu. Ama kitap"
        },
        {
          "t": "ikon",
          "v": "📖"
        },
        {
          "t": "metin",
          "v": " işareti hangi kitabı anlatıyordu? Saatlerce raflar arasında dolaştı, her kitabın sırtına tek tek baktı, ama bir sonuç bulamadı. Yorulmuştu, ama vazgeçmek de istemiyordu. "
        },
        {
          "t": "deger",
          "anahtar": "karar"
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Ertesi gün "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ", "
        },
        {
          "t": "yoldas",
          "hal": "yonelme",
          "yedek": "bir arkadaşına"
        },
        {
          "t": "metin",
          "v": " seslendi. Arkadaşı haritayı görünce hemen heyecanlandı. "
        },
        {
          "t": "deyim",
          "yuva": "el_ele"
        },
        {
          "t": "metin",
          "v": " İkisi birlikte raflara baktılar. Kitap"
        },
        {
          "t": "ikon",
          "v": "📖"
        },
        {
          "t": "metin",
          "v": " işareti, tozlu bir ansiklopedinin arkasındaki bir kâğıt parçasına işaret ediyordu: \"Beş adım sağa, üç adım geri.\" Kâğıdın altında küçük bir yıldız"
        },
        {
          "t": "ikon",
          "v": "⭐"
        },
        {
          "t": "metin",
          "v": " çizilmişti; demek ki doğru yoldaydılar."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " ve "
