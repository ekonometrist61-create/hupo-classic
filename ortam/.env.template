# Kişisel Yazılım Fabrikası - ortam değişkenleri ŞABLONU
# Bu dosyayı `.env.example` olarak kopyala. Gerçek değerleri BURAYA YAZMA.
# Gerçek sırlar: parola yöneticisi + GitHub Secrets + Vercel/Supabase/Expo panelleri.
# Kural: NEXT_PUBLIC_ ile başlayan değişken tarayıcıya gider -> gizli anahtar koyma.

# ---------- Kimlik ----------
FABRIKA_ENV=local            # local | server | ci
NODE_ENV=development

# ---------- Claude Code ----------
ANTHROPIC_API_KEY=            # YALNIZCA sunucu/CI'da; laptopta abonelik girişi kullanilir
CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192

# ---------- GitHub ----------
GITHUB_TOKEN=                 # Depo kapsaminda, en az yetki. GitHub Secrets'a koy
GITHUB_REPO=

# ---------- Veritabani (gelistirme) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ---------- Supabase ----------
SUPABASE_URL=                 # https://<proje-ref>.supabase.co
SUPABASE_ANON_KEY=            # Guvenli: tarayici/mobil kullanir
SUPABASE_SERVICE_ROLE_KEY=    # ASLA mobil/tarayici kodunda. Sadece sunucu/CI

# ---------- Uygulama ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=     # NEXT_PUBLIC_ = tarayiciya gider, sadece SUPABASE_URL olabilir
LOG_LEVEL=info

# ---------- Sunucu / SSH ----------
FABRIKA_SERVER_HOST=fabrika-sunucu
FABRIKA_SERVER_IP=            # Tailscale kurulduysa gerekmez
FABRIKA_SSH_PORT=22
FABRIKA_USER=ubuntu

# ---------- Yedekleme ----------
BACKUP_B2_BUCKET=
BACKUP_RESTIC_PASSWORD=       # parola yoneticisinde; bu dosyaya YAZMA
BACKUP_S3_ENDPOINT=s3.us-west-004.backblazeb2.com

# ---------- Gozenlenebilirlik ----------
SENTRY_DSN=                   # NEXT_PUBLIC olmali; ilk gercek kullaniciya kadar gerekmez
UPTIME_CHECK_URL=https://example.com

# ---------- CI (GitHub Actions) ----------
CI=true
NODE_VERSION=24