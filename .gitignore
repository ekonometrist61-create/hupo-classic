# =====================================================================
#  Öğrenci Hazırlık (Hupo) — kök .gitignore
#  Kural: elle yazılan kaynak commit edilir; üretilen, kurtarma kanıtı ve
#  sırlar commit EDİLMEZ. (Bkz. AGENTS.md §2, §5 ve docs/arsiv/TEMIZLIK_RAPORU.md §6)
# =====================================================================

# --- Bağımlılıklar / üretilen çıktılar (yeniden üretilir) ---
node_modules/
.next/
.next-test/
build/
.dart_tool/
*.tsbuildinfo
*.pid

# --- Günlükler ---
*.log
*.log.err

# --- Kurtarma kanıtı: APK, libapp.so, dökümler (AGENTS.md §2: git'e girmemeli) ---
kurtarilan/

# --- Karantina: kalıcı silinmesi için kullanıcı onayı bekliyor ---
Silinecekler/

# --- Ortam dosyaları ve sırlar (AGENTS.md §5: asla commit edilmez) ---
.env
.env.local
.env.*.local
**/.env*.local
key.properties
*.jks
*.keystore
*.pem
# MCP sunucu konfigü API anahtarı içeriyor (GEMINI_API_KEY vb.)
.mcp.json

# --- Supabase CLI geçici dosyaları ---
supabase/.temp/

# --- Editör / işletim sistemi ---
.idea/
.DS_Store
Thumbs.db

# --- Yanlış yönlendirmeyle oluşmuş dosyalar (docs/arsiv/TEMIZLIK_RAPORU.md §3) ---
e.innerText)
e.innerText)})

# --- Arşiv: git dışında tutulur, disk üzerinde saklanır (TASKS.md §11.5) ---
docs/arsiv/

# Karakter gorselleri web-panel/public/characters altinda git'te izlenir (Vercel derlemesi icin).
# Uretim promptlari (*.prompt.txt) herkese acik klasore girmez.
web-panel/public/characters/**/*.prompt.txt
.vercel

# Firebase yerel yapılandırma (push)
mobile-app/firebase_defines.json
mobile-app/android/app/google-services.json
mobile-app/ios/Runner/GoogleService-Info.plist
