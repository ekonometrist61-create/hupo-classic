# Bu dosyayı .env.local olarak kopyalayıp doldurun (.env.local git'e girmez).
# Supabase Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co

# Publishable (anon) key — tarayıcıya açık olabilir, RLS ile korunur.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key ASLA NEXT_PUBLIC_ önekiyle tanımlanmaz ve istemci koduna girmez.
# Yalnızca sunucu tarafında (route handler / server action) gerekirse:
# SUPABASE_SECRET_KEY=sb_secret_...

# Analitik (isteğe bağlı). Anahtar boşsa analitik tamamen kapalıdır; yalnızca kullanıcı
# çerez onayı verdiğinde yüklenir. Proje anahtarı gizli değildir ama proje başınadır.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Veli rehberleri (lead magnet) sayfası ve landing bandı. 'true' değilse sayfa 404 verir. Hukuk onayı (GÖR-078) gelmeden açma.
# NEXT_PUBLIC_LEAD_MAGNET_ACIK=false
