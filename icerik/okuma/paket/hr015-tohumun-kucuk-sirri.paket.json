        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " cetvelin yanına küçük bir su kabı resmi çizdi."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "\"Uzun olması güçlü olduğu anlamına gelir mi? Yapraklarına da bakalım,\" dedi "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ". Öğretmenleri açıklama yapmadan önce çocuklardan "
