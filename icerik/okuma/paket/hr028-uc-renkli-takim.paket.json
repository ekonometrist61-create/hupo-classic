  "sayfalar": [
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Okul bahçesinde “Üç Renkli Oyun” yapılacaktı. Takımlar üç kişiydi. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " ip atlamayı, "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " top sürmeyi, Cem ise "
        },
        {
          "t": "kelime",
          "yuva": "hr028_bulmaca"
        },
        {
          "t": "metin",
          "v": " çözmeyi seviyordu. Üçü aynı takıma seçilince "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " homurdandı: “Biz hiç aynı oyunu sevmiyoruz.”\n\nÖğretmenleri kuralları açıkladı. İlk durakta ip "
        },
        {
          "t": "kelime",
          "yuva": "hr028_engel"
        },
        {
          "t": "metin",
          "v": " geçilecek, ikinci durakta top hedefe atılacak, son durakta renkli kartların "
        },
        {
          "t": "kelime",
          "yuva": "hr028_sifre"
        },
        {
          "t": "metin",
          "v": " çözülecekti. Takımın başarısı için üç görev de gerekliydi.\n\nBaşlama işareti verilince "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " öne fırladı. Fakat ilk ip engelinde takıldı. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " ona yavaşça gösterdi: “Önce sağ ayak, sonra sol. Acele etme.” "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " denedi ve geçti."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Top durağında "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " topu iki kez kaçırdı. "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " kızmak üzereydi, sonra ilk durakta aldığı yardımı hatırladı. “Topu sert değil, kontrollü gönder,” dedi. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " bu kez hedefi buldu. Cem alkışladı.\n\nSon durakta masaya üç kart koyulmuştu: kırmızı, mavi ve sarı. Yanlarındaki notta şöyle yazıyordu: Kırmızı, maviden önce; sarı, kırmızıdan sonra; mavi ise en sonda. Cem kartları sıraya dizdi. Fakat öğretmen ilk dizilişi onaylamadı.\n\nCem dikkatle düşündü. “Sarı, kırmızıdan sonra olabilir; ama maviden önce olmak zorunda mı?” diye sordu. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ", “Mavi en son,” dedi. “Öyleyse sıra kırmızı, sarı, mavi!”"
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Tam son kartı yerleştirirken bir rüzgâr çıktı ve mavi kart uçtu. "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " arkasından koşmaya kalktı, fakat öğretmen bahçe sınırını gösterdi. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ", görevliden yedek kart istedi. Yarış biraz gecikti ama kurallara uydular.\n\nYarışın sonlarına doğru başka bir takımın kartlarından biri de yere düştü. "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " onu görünce bir an tereddüt etti. Kartı geri vermek için durursa kendi takımları daha da yavaşlayacaktı. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " gözleriyle ne yapacağını sordu. "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " kartı alıp görevliye teslim etti. “Onlar da oyunu bitirebilsin,” dedi. Cem hafifçe gülümsedi; "
        },
        {
          "t": "yoldas",
          "hal": "ilgi",
          "yedek": "bir arkadaşın"
        },
        {
          "t": "metin",
          "v": " en hızlı olduğu şeyin yalnız koşmak olmadığını düşündü."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Son kartları dizdikten sonra üç arkadaş ellerini üst üste koydu. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " ip atlamayı bilmeyenlere yeniden göstermeyi, "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " topu korkmadan deneyenlere cesaret vermeyi, Cem ise zor bilmecelerin ipuçlarını paylaşmayı teklif etti. Kimse ötekinin bütün işlerini yapmak zorunda değildi. "
        },
        {
          "t": "vurgu",
          "v": "Herkes kendi güçlü yanını sunabilirdi"
        },
        {
          "t": "metin",
          "v": ". "
        },
        {
          "t": "isaret",
          "kod": "kalp"
        },
        {
          "t": "metin",
          "v": "\n\nSonuçlar açıklandığında birinci olamadılar.\n\nSonuçlar açıklandığında birinci olamadılar. Üçüncülük kurdelesini alırken "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " üzülmüştü. Cem ise her arkadaşının bir görevde takımı ilerlettiğini söyledi. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " üç kurdeleyi yan yana tuttu: “Farklı renkler birlikte daha güzel görünmüyor mu?”\n\nErtesi gün "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " bir öneriyle geldi: “Bu kez herkesin sevdiği bir oyunu birlikte deneyelim.” Önce ip atladılar, sonra top oynadılar, en sonda Cem'in bilmecelerini çözdüler. Üçü de bütün oyunları aynı derecede sevmedi. Yine de artık farklı olmanın birlikte eğlenmelerine engel olmadığını biliyorlardı."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Dil hedefi: aynı–farklı, karşılaştırma, sıralama; Kavram/değer: takım çalışması, bireysel güçlü yönler, kurallara saygı. İkon önerileri: üç renk, top, el. Okuma sonrası: Her çocuk hangi görevde takımı ilerletti? Birinci olmamaları neyi değiştirdi?"
        }
      ]
    }
  ],
