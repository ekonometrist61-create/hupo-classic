  "sayfalar": [
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "ilgi"
        },
        {
          "t": "metin",
          "v": " dedesi, kelimelerle oynayan küçük bir makine yapmıştı. Makinenin üstünde üç düğme vardı: Oku, Düşün, Söyle. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " ilk düğmeye bastığında ekranda şu cümle belirdi: Bahçedeki "
        },
        {
          "t": "kelime",
          "yuva": "hr026_gul"
        },
        {
          "t": "metin",
          "v": " bana güldü.\n\n“Çiçek mi kahkaha attı?” diye sordu kardeşi "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": ".\n\nMakine cümleyi yorumlamak yerine masaya kırmızı bir gül resmi çizdi ve yanına kahkaha işareti koydu. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ", “İkisi de gül diye yazılıyor ama aynı anlama gelmiyor,” dedi.\n\nDede gülümsedi. “Demek ki bir kelimenin nerede kullanıldığını anlamak gerekiyor.”\n\n"
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " yeni cümleyi söyledi: “Dedem "
        },
        {
          "t": "kelime",
          "yuva": "hr026_yuz"
        },
        {
          "t": "metin",
          "v": " sayfasını okudu.” Makine masaya yüz tane yüz resmi çizdi."
        },
        {
          "t": "deyim",
          "yuva": "hr026_iki_buklum"
        },
        {
          "t": "metin",
          "v": " “Ben sayıyı söyledim!”"
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " defterine örnekleri yazdı. Bir tarafta yüz sayısı, diğer tarafta yüz sözcüğünün insanın suratı anlamı vardı. Sonra kardeşinden yeni bir örnek istedi. "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " hemen, “Yaz geldi, sen de yaz!” dedi. Makine ekrana güneş resmi ve bir kalem çizdi. Bu kez doğruya yaklaşmıştı. "
        },
        {
          "t": "isaret",
          "kod": "kitap"
        },
        {
          "t": "metin",
          "v": "\n\nDede, masaya iki kart daha koydu. Birinde “Kışın "
        },
        {
          "t": "kelime",
          "yuva": "hr026_kar"
        },
        {
          "t": "metin",
          "v": " yağdı”, diğerinde “Bize kâr kaldı” yazıyordu. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " harfleri dikkatle inceledi. “Bunlar aynı yazılmıyor; sesleri de tam aynı değil,” dedi. Dede onayladı: “Her benzer kelimeyi aynı gruba koyamayız.” "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " de yeni bir kart istedi. “O zaman yalnız gerçekten aynı yazılan ve farklı anlamlara gelen örneklerle başlayalım.”"
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Makine bu uyarıyı duyunca ekrana büyük bir soru işareti çıkardı. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ", “"
        },
        {
          "t": "vurgu",
          "v": "Sorular bazen cevaptan daha işe yarar"
        },
        {
          "t": "metin",
          "v": ",” diye düşündü. Makinenin hatasını bulmak, düğmelerine rastgele basmaktan daha çok zaman almış ama daha eğlenceli olmuştu.\n\n"
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " bütün cümlelerin küçük bir ipucu taşıdığını fark etti.\n\n"
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " bütün cümlelerin küçük bir ipucu taşıdığını fark etti. “Yaz geldi” derken mevsimden söz ediyorlardı. “Sen de yaz” derken ise kalemle bir şeyler yazmayı istiyorlardı. Kelimenin yanındaki başka sözcükler anlamı bulmalarını sağlıyordu.\n\nDede, “Peki makinenin hatasını nasıl azaltacağız?” diye sordu. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " bir kural kartı hazırladı: Önce tüm cümleyi oku; sonra kelimenin anlamını seç. Kartı makinenin yanına koydular."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Son denemede "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": ", “Çay kıyısında çay içtik,” dedi. Makine bu kez su akan bir dere ile iki fincan çizdi. İki kardeş sevinçle alkışladı.\n\nAncak makine beklenmedik bir soru sordu: “Peki kelimelerin iki anlamı varsa, insanların da bazen birden fazla duygusu olur mu?”\n\n"
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " biraz düşündü. “Olur,” dedi. “Hem heyecanlı hem çekingen olabilirim.” Dede ona bakıp gülümsedi. Bir kelime oyunu, o gün yeni bir konuşmanın kapısını açmıştı.\n\nDil hedefi: sesteş/homograf kullanımlar: gül, yüz, yaz, çay; Kavram/değer: bağlam, çok anlamlılık, esnek düşünme. İkon önerileri: robot, sözlük, konuşma balonu. Okuma sonrası: “Yaz geldi, sen de yaz” cümlesindeki iki yazın anlamı nedir?"
        }
      ]
    }
  ],
