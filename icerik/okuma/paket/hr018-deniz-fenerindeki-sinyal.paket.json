        {
          "t": "ikon",
          "v": "wave"
        },
        {
          "t": "metin",
          "v": " kabarıyor, dalgalar taşlara çarpıyordu. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ", \"Bizim gördüğümüzü anlatmamız yeterli,\" dedi. Babası görevliye telefonla konumlarını tarif ederken "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
