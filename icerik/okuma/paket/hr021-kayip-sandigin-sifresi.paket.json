        },
        {
          "id": "C",
          "metin": "Tek başına çalışmayı"
        },
        {
          "id": "D",
          "metin": "Hediye almayı"
        }
      ],
      "dogru": "B",
      "aciklama": "Her yazıda \"Birlikte\" sözcüğü vardı; sınıf yaptıklarını birlikte yapmayı önemsiyordu."
