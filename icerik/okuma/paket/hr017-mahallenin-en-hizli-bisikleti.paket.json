        {
          "t": "ikon",
          "v": "question"
        },
        {
          "t": "metin",
          "v": " göründüğüne değil, güvenli olup olmadığına bakalım,\" dedi babası. "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "Hupo"
        },
        {
          "t": "metin",
          "v": " de frenleri denemeye yardım"
