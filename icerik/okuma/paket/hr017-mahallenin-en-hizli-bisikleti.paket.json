          "t": "metin",
          "v": " kendi "
        },
        {
          "t": "kelime",
          "yuva": "s2_eski"
        },
        {
          "t": "metin",
          "v": " bisikletini çok seviyordu. Mahalle yarışına katılmaya karar verdiğinde babası önce kaskını ve frenleri kontrol etti."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Yarış afişini görünce "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " gidonu sıkıca tuttu. Mert'in bisikleti "
        },
        {
          "t": "kelime",
          "yuva": "s2_yeni"
        },
        {
          "t": "metin",
          "v": " ve parlaktı. \"Önce bisikletin nasıl"
        },
        {
          "t": "ikon",
          "v": "question"
        },
        {
          "t": "metin",
          "v": " göründüğüne değil, güvenli olup olmadığına bakalım,\" dedi babası. "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "Hupo"
        },
        {
          "t": "metin",
          "v": " de frenleri denemeye yardım"
        },
        {
          "t": "ikon",
          "v": "hand-help"
        },
        {
          "t": "metin",
          "v": " etti. Kaskın tam oturduğundan emin oldular."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Antrenman için okulun yanındaki boş alana gittiler. İlk gün küçük dönüşlerde yavaşladı, ikinci gün daha dengeli sürdü. Bir hafta sonra bir çizginin üzerinden dikkatle geçebiliyordu. Mert ara sıra ona eşlik etti: \"Yavaş git, düşme yeter!\""
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Yarış sabahı start çizgisinde bisikletler yan yana duruyordu. Tam o sırada Mert'in bisikletinin zinciri çıktı. Yüzü asıldı: \"Her şey bitti.\" "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " başlama işaretini kaçırmaktan korktu. Ama arkadaşının üzgün hâlini görünce elini kaldırıp görevliye seslendi."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Görevli zincirin düzeltilmesine yardım"
        },
        {
          "t": "ikon",
          "v": "hand-help"
        },
        {
          "t": "metin",
          "v": " etti ve bisikleti kısaca kontrol etti. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " zincir yerine oturana kadar Mert'in yanında bekledi."
        },
        {
          "t": "ikon",
          "v": "friends"
        },
        {
          "t": "metin",
          "v": " Yarış başlamıştı; ikisi son anda yerlerini alıp geriden başladı. Mert gülerek: \""
        },
        {
          "t": "atasozu",
          "yuva": "ata_elin_nesi"
        },
        {
          "t": "metin",
          "v": "\" dedi."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " birinci olmadı. Finişte Mert ona sarıldı: \"Sen olmasaydın hiç başlayamazdım.\" "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "Hupo"
        },
        {
          "t": "metin",
          "v": " de bu sözü duyunca gülümsedi. "
