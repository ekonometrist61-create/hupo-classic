  "sayfalar": [
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Bisikletin boyası yer yer dökülmüştü. Arkadaşlarınınkiler parlaktı ama "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " kendi "
        },
        {
          "t": "kelime",
          "yuva": "s2_eski"
        },
        {
          "t": "metin",
          "v": " bisikletini çok seviyordu. Bir gün mahalle yarışının afişini gördü ve yarışa katılmaya karar verdi."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " gidonu sıkıca tuttu. Komşumuz Mert'in bisikleti "
        },
        {
          "t": "kelime",
          "yuva": "s2_yeni"
        },
        {
          "t": "metin",
          "v": " ve parlaktı. \"Önce bisikletin güvenli olup olmadığına bakalım,\" dedi babası. "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "Hupo"
        },
        {
          "t": "metin",
          "v": " de frenleri denemeye yardım"
        },
        {
          "t": "ikon",
          "v": "hand-help"
        },
        {
          "t": "metin",
          "v": " etti. Kaskın tam oturduğundan emin oldular."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Antrenman için okulun yanındaki boş alana gittiler. İlk gün küçük dönüşlerde yavaşladı, ikinci gün daha dengeli sürdü. Bir hafta sonra yere çizilen düz bir çizgi boyunca sapmadan gidebiliyordu. Mert ara sıra ona eşlik etti: \"Acele etme, yavaş sür!\""
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Yarış sabahı başlangıç çizgisinde bisikletler yan yana duruyordu. Tam o sırada Mert'in bisikletinin zinciri çıktı. Yüzü asıldı: \"Her şey bitti.\" "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " başlama işaretini kaçırmaktan korktu. Ama arkadaşının üzgün hâlini görünce elini kaldırıp görevliye seslendi."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Görevli geldi. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " ile Mert bisikleti birlikte tuttular. "
        },
        {
          "t": "ikon",
          "v": "hand-help"
        },
        {
          "t": "metin",
          "v": " Görevli zinciri taktı ve bisikleti kısaca kontrol etti. İkisi son anda yarışa yetişip yan yana başladı. Mert gülerek \""
        },
        {
          "t": "atasozu",
          "yuva": "ata_elin_nesi"
        },
        {
          "t": "metin",
          "v": "\" dedi."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " birinci olmadı. Bitiş çizgisinde Mert ona sarıldı: \"Sen olmasaydın hiç başlayamazdım.\" "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "Hupo"
        },
        {
          "t": "metin",
          "v": " de bu sözü duyunca gülümsedi. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " eski bisikletinin gidonuna küçük bir yıldız"
        },
        {
          "t": "ikon",
          "v": "star"
        },
        {
          "t": "metin",
          "v": " çıkartması yapıştırdı."
        },
        {
          "t": "isaret",
          "kod": "yildiz"
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Akşam "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " kaskını rafına koydu. Gidondaki yıldız, pencereden giren ışıkta parlıyordu."
        }
      ]
    }
  ],
