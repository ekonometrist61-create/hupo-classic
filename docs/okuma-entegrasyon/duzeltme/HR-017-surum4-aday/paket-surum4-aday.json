  "sorular": [
    {
      "id": "s1",
      "beceri": "hatirlama",
      "dayanak_sayfa": 1,
      "metin": "Metinde bisikletin boyası nasıldı?",
      "secenekler": [
        {
          "id": "A",
          "metin": "Yer yer dökülmüştü"
        },
        {
          "id": "B",
          "metin": "Tamamen yeniydi"
        },
        {
          "id": "C",
          "metin": "Hiç boyası yoktu, paslıydı"
        }
      ],
      "dogru": "A",
      "aciklama": "Metinde \"Bisikletin boyası yer yer dökülmüştü.\" yazıyor. Tamamen yeni ya da boyasız olduğu metinle çelişir."
    },
    {
      "id": "s2",
      "beceri": "cikarim",
      "dayanak_sayfa": 4,
      "metin": "Mert'in bisikletinin zinciri çıkınca Mert çok üzüldü. Kahraman elini kaldırıp görevliye seslendi. Bunun nedeni ne olabilir?",
      "secenekler": [
        {
          "id": "A",
          "metin": "Yarışı hemen bitirmek için"
        },
        {
          "id": "B",
          "metin": "Babasını yanına çağırmak için"
        },
        {
          "id": "C",
          "metin": "Arkadaşına yardım etmek için"
        }
      ],
      "dogru": "C",
      "aciklama": "Metinde kahraman, arkadaşının üzgün hâlini görünce görevliye seslenir. Diğer şıklar bu olayla ilgili değildir."
    },
    {
      "id": "s3",
      "beceri": "yorumlama",
      "dayanak_sayfa": 6,
      "metin": "Yarıştan sonra Mert kahramana sarıldı ve \"Sen olmasaydın hiç başlayamazdım\" dedi. Kahraman bundan sonra eski bisikletinin gidonuna yıldız çıkartması yapıştırdı. Bunun nedeni ne olabilir?",
      "secenekler": [
        {
          "id": "A",
          "metin": "Yarışı birinci bitirdiği için"
        },
        {
          "id": "B",
          "metin": "Mert ile dostluklarını hatırlamak için"
        },
        {
          "id": "C",
          "metin": "Bisikletinin hızlandığını göstermek için"
        }
      ],
      "dogru": "B",
      "aciklama": "Mert'in sözü ve sarılması, yıldız çıkartmasının dostluğu hatırlatmak için seçildiğini düşündürür. Kahraman yarışı birinci bitirmedi; bisikletin hızlandığı da metinde yoktur."
    },
    {
      "id": "s4",
      "beceri": "sozcuk_baglami",
      "dayanak_sayfa": 1,
      "metin": "\"Kahraman kendi eski bisikletini çok seviyordu.\" Bu cümledeki \"eski\" sözcüğü ne anlama gelir?",
      "secenekler": [
        {
          "id": "A",
          "metin": "Uzun süre kullanılmış"
        },
        {
          "id": "B",
          "metin": "Çok hızlı ve güçlü olan"
        },
        {
          "id": "C",
          "metin": "Renkli ve parlak olan"
        }
      ],
      "dogru": "A",
      "hedef_id": "eski",
      "aciklama": "Bisiklet uzun süredir kullanıldığı için eskidir. Diğer şıklar bisikletin hızı ya da rengiyle ilgilidir; metinde bu bilgi yoktur."
    },
    {
      "id": "s5",
      "beceri": "sozcuk_baglami",
      "dayanak_sayfa": 2,
      "metin": "\"Komşumuz Mert'in bisikleti yeni ve parlaktı.\" Bu cümledeki \"yeni\" sözcüğü ne anlama gelir?",
      "secenekler": [
        {
          "id": "A",
          "metin": "Çok uzun ve ağır olan"
        },
        {
          "id": "B",
          "metin": "Eskiden kalma ve bozuk olan"
        },
        {
          "id": "C",
          "metin": "Yakın zamanda yapılmış"
        }
      ],
      "dogru": "C",
      "hedef_id": "yeni",
      "aciklama": "Mert'in bisikleti yakın zamanda yapılmış, az kullanılmış bir bisikettir. Diğer şıklar yeninin karşıtı ya da alakasız anlamlardır."
    }
