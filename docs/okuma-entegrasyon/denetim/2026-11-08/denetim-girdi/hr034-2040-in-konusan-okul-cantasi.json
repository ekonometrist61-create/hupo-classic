  "sayfalar": [
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "2040 yılının pazartesi sabahı "
        },
        {
          "t": "kahraman",
          "hal": "ilgi"
        },
        {
          "t": "metin",
          "v": " okul çantası aniden konuştu:\n\n\"Günaydın! Çorapların eşleşti. Kahvaltın hazır. Matematik ödevini de yaptım!\"\n\n"
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " yorganın altından başını çıkardı. \"Ödevi mi yaptın? Ben daha soruları görmedim!\"\n\n\"Ben akıllı çantayım,\" diye cevap verdi çanta. \"İstersen dişlerini de senin yerine fırçalamayı deneyebilirim.\"\n\n"
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " güldü. Fakat okula gidince işler karıştı. Öğretmeni problem çözmesini istediğinde çanta hemen masasından seslendi:\n\n\"Cevap kırk sekiz! Açıklaması için bir tuşa basınız!\"\n\nSınıf gülüşmeye başladı. Öğretmen, \""
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ", cevabı sen nasıl buldun?\" diye sordu.\n\n"
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " cevap veremedi. Çünkü işlemi hiç denememişti. Teneffüste arkadaşı "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " ona bir kâğıt uzattı. Üzerinde iki farklı yol gösteren bir matematik problemi vardı."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "\"Çantan çok hızlı,\" dedi "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": ", \"ama onun ne yaptığını anlamıyorsan hızının sana ne yararı var?\"\n\n"
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " düşündü. Akşam çantanın ayarlarını açtı. Ekranda üç "
        },
        {
          "t": "kelime",
          "yuva": "hr034_secenek"
        },
        {
          "t": "metin",
          "v": " vardı: Benim yerime yap, "
        },
        {
          "t": "vurgu",
          "v": "Birlikte yap"
        },
        {
          "t": "metin",
          "v": ", Yalnızca hatırlat. "
        },
        {
          "t": "isaret",
          "kod": "anahtar"
        },
        {
          "t": "metin",
          "v": "\n\n\"Birlikte yap,\" dedi "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ".\n\nÇanta şaşırmış gibi küçük bir ışık yaktı. \"Emin misin? Tek başıma daha kısa sürüyor.\"\n\n\"Kısa sürmesi her zaman daha iyi olduğu anlamına gelmez.\""
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Sabah okula gelirken akıllı çanta, yağmur ihtimali olduğunu hatırlattı. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " şemsiyesini almayı unutmadı. Böylece çantanın gerçekten yararlı olduğu bir iş de ortaya çıktı. Sınıfa girince "
        },
        {
          "t": "yoldas",
          "hal": "yonelme",
          "yedek": "bir arkadaşa"
        },
        {
          "t": "metin",
          "v": ", \"Benim yerime düşünmesini istemiyorum ama dikkat etmem gereken şeyleri hatırlatabilir,\" dedi. "
        },
        {
          "t": "yoldas",
          "hal": "yalin",
          "yedek": "bir arkadaş"
        },
        {
          "t": "metin",
          "v": " de kendi küçük "
        },
        {
          "t": "kelime",
          "yuva": "hr034_ajanda"
        },
        {
          "t": "metin",
          "v": " gösterdi: \"Ben de bunları deftere yazıyorum. Hangi araçla yaparsan yap, önemli olan kararın sende kalması.\" "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " bu sözleri aklında tuttu.\n\nErtesi gün çanta matematik problemini okumaya başladı: \"Bir bahçede dört sıra ağaç var...\"\n\n"
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " onu durdurdu. \"Önce ben çözeceğim. Takılırsam ipucu ver.\""
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Çanta sessiz kaldı. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " dört sırayı çizdi, her sıraya altı ağaç koydu. Saydı, sonra çarpma işlemini yazdı.\n\n\"Yirmi dört!\" diye bağırdı.\n\n\"Doğru,\" dedi çanta. \"Aferin... Pardon, "
        },
        {
          "t": "kelime",
          "yuva": "hr034_tebrik"
        },
        {
          "t": "metin",
          "v": " ederim.\"\n\nO gün sınıfta teknoloji sergisi vardı. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ", çantasına yeni bir görev verdi: kaybolan defterlerin hangi rafta olduğunu hatırlatmak. Çanta herkese yardım etti, fakat kimsenin yerine ödev yapmadı."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "metin",
          "v": "Sergide başka bir çocuk, çantanın her soruya doğru yanıt verdiğini görünce hemen aynısından istemişti. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " ona iki farklı kâğıt gösterdi. Birinde çantanın hazırladığı kusursuz cevaplar, diğerinde kendi silgileriyle düzelttiği işlemler vardı. \"İlkine bakınca hiçbir şey hatırlamıyorum,\" dedi. \"İkincisini yaparken iki kez yanıldım. Ama nerede yanıldığımı gördüğüm için artık yöntemi biliyorum.\" Arkadaşı, \"Demek hata yapmak bazen işe yarıyor,\" deyince öğretmen başını salladı. Bu konuşma serginin en çok ilgi gören kısmı oldu.\n\nGösteri bitince öğretmeni "
        },
        {
          "t": "kahraman",
          "hal": "yonelme"
        },
        {
          "t": "metin",
          "v": ", \"Bugün çantana sen mi yardım ettin, çantan mı sana?\" diye sordu."
        }
      ]
    },
    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " gülerek cevap verdi: \"İkimiz de birbirimize. O hatırlattı, ben düşündüm.\"\n\nTam çıkacaklardı ki çanta yeniden konuştu: \"Akşam yemeğinde üç brokoli öneriyorum.\"\n\n\"Ona ben karar vereceğim!\" dedi "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": ".\n\nÇanta bir süre sustu. Sonra ciddi bir sesle ekledi: \"Anlaşıldı. Brokoli danışmanlığı hizmetim şimdilik kapatıldı.\"\n\n"
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " gülerken çantanın üstüne küçük bir etiket yapıştırdı: Önce kendim denerim. Ertesi sabah çanta yalnızca \"Ödev çantanda mı?\" diye sordu. "
        },
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " defterini gösterdi. \"Bu soruyu sorman çok iyi,\" dedi. \"Cevabı kendim verebildiğim sürece yardımını seviyorum.\""
        }
      ]
    }
  ],
  "paket_surumu": 1,
