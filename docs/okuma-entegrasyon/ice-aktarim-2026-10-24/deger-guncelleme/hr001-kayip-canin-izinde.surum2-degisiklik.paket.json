    {
      "omurga": true,
      "parcalar": [
        {
          "t": "kahraman",
          "hal": "yalin"
        },
        {
          "t": "metin",
          "v": " hemen yukarı uzanmak istedi. Ancak yerde kaygan taşlar vardı. \"Dur,\" dedi "
