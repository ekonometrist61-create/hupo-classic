  ]
 },
 {
  "no": 28,
  "sinif": 3,
  "soru": "“Bir elin nesi var, iki elin sesi var.” atasözü ne anlatır?",
  "secenekler": [
   "Her iş tek başına yapılmalıdır",
   "Eller her zaman temiz tutulmalı",
   "Alkış tutmak çok kolay bir iştir",
   "İşler birlikte yapılınca daha iyi olur"
  ]
 },
 {
  "no": 29,
  "sinif": 3,
  "soru": "“Sabreden derviş muradına ermiş.” atasözü ne anlatır?",
